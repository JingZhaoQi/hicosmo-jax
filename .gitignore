# HIcosmo Repository

# Ignore everything by default
*

# Allow only these directories and files
!hicosmo/
!hicosmo/**
!examples/
!examples/**
!tutorials/
!tutorials/**
!README.md
!.gitignore
!pyproject.toml
!requirements.txt

# Large data files (never commit)
hicosmo/data/
examples/data/

# Incomplete modules (not ready for release)
hicosmo/likelihoods/gw/
*.h5
*.hdf5
*.pkl
*.p
*.npy

# Python artifacts
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/

# Jupyter checkpoints
.ipynb_checkpoints/

# IDE
.idea/
.vscode/
*.swp

# OS files
.DS_Store
Thumbs.db

# Test/temp files
*.log
*.tmp
.pytest_cache/
.coverage
htmlcov/

# MCMC chains and results (large files)
mcmc_chains/
results/*.pdf
results/*.png
